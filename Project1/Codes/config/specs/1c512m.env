# VM spec 1c512m: the whole Linux VM (kernel + Docker + database) gets these resources.
SPEC_NAME=1c512m
SPEC_CPU=1
SPEC_MEM_GB=0.5
# "tuned" configuration = memory parameters sized for this spec (default config = image defaults).
SHARED_BUFFERS=96MB
WORK_MEM=4MB
MAINT_WORK_MEM=32MB
MAX_CONNECTIONS=100
OG_MAX_PROCESS_MEMORY=2GB
