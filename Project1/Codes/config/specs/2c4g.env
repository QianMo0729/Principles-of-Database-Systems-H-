# VM spec 2c4g: the whole Linux VM (kernel + Docker + database) gets these resources.
SPEC_NAME=2c4g
SPEC_CPU=2
SPEC_MEM_GB=4
# "tuned" configuration = memory parameters sized for this spec (default config = image defaults).
SHARED_BUFFERS=1GB
WORK_MEM=16MB
MAINT_WORK_MEM=256MB
MAX_CONNECTIONS=200
OG_MAX_PROCESS_MEMORY=3GB
