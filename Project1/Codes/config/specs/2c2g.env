# VM spec 2c2g: the whole Linux VM (kernel + Docker + database) gets these resources.
SPEC_NAME=2c2g
SPEC_CPU=2
SPEC_MEM_GB=2
# "tuned" configuration = memory parameters sized for this spec (default config = image defaults).
SHARED_BUFFERS=512MB
WORK_MEM=8MB
MAINT_WORK_MEM=128MB
MAX_CONNECTIONS=100
OG_MAX_PROCESS_MEMORY=2GB
