# VM spec 4c8g: the whole Linux VM (kernel + Docker + database) gets these resources.
SPEC_NAME=4c8g
SPEC_CPU=4
SPEC_MEM_GB=8
# "tuned" configuration = memory parameters sized for this spec (default config = image defaults).
SHARED_BUFFERS=2GB
WORK_MEM=16MB
MAINT_WORK_MEM=512MB
MAX_CONNECTIONS=200
OG_MAX_PROCESS_MEMORY=5GB
