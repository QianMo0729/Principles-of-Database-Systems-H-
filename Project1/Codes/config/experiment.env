# Global experiment parameters, sourced by every script in Codes/scripts.

# --- container images (all linux/arm64, run natively on Apple silicon) ---
PG_IMAGE=postgres:18
OG_IMAGE=enmotech/opengauss:6.0.0
JDK_IMAGE=eclipse-temurin:25-jdk

# --- names inside the VM ---
NET=dbbench                 # user-defined bridge network
DATA_VOL=dbbench_data       # raw + cleaned IMDb files (never stored in the project folder)
PG_VOL=dbbench_pgdata
OG_VOL=dbbench_ogdata
PG_CONTAINER=bench-pg
OG_CONTAINER=bench-og

# --- access ---
DB_PASSWORD='Bench@2026db'  # throw-away password for the local benchmark VM only
PG_PORT=15432               # published on the VM address
OG_PORT=15433
PG_USER=postgres
OG_USER=gaussdb

# --- dataset ---
IMDB_BASE_URL=https://datasets.imdbws.com
IMDB_FILES="title.basics name.basics title.ratings"
SCALES="${SCALES:-s m l}"   # 1 % / 10 % / 100 % deterministic samples of the real data

# --- measurement (each value can be overridden from the environment, e.g. for a quick smoke run) ---
STANDARD_SPEC=4c8g          # VM spec used for file-vs-DBMS and for the performance comparison
SERVER_SPEC=2c2g            # the spec of the real server this study is meant to inform
LADDER_SPECS="${LADDER_SPECS:-1c512m 1c1g 2c2g 2c4g 4c8g}"
REPS="${REPS:-5}"
WARMUP="${WARMUP:-2}"
LOAD_CLIENTS="${LOAD_CLIENTS:-1 4 16 64}"
LOAD_SECONDS="${LOAD_SECONDS:-20}"
LOAD_WARMUP_SECONDS="${LOAD_WARMUP_SECONDS:-5}"
SOAK_SECONDS="${SOAK_SECONDS:-600}"
